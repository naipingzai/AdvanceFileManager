prefix=D:/AndroidApp/MaterialFile/prebuild/native/libarchive
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libarchive
Description: library that can create and read several streaming archive formats
Version: 3.7.7
Cflags: -I${includedir}
Cflags.private: -DLIBARCHIVE_STATIC
Libs: -L${libdir} -larchive
Libs.private:  -lz -lmaterialfile_bz2 -lmaterialfile_lzma -lmaterialfile_lz4 -lmaterialfile_zstd -lmaterialfile_mbedcrypto
Requires.private: 
