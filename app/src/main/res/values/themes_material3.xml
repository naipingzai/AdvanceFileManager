        <item name="textAppearanceDisplayMedium">@style/TextAppearance.NpzLib.M3.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.NpzLib.M3.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.NpzLib.M3.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.NpzLib.M3.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.NpzLib.M3.HeadlineSmall</item>
