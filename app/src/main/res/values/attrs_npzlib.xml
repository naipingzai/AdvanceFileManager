  ~
  ~ 语义化主题属性声明
  ~ 所有布局应通过 ?attr/ 引用这些属性，而非直接引用 Material3 原始 TextAppearance。
  -->

<resources>

    <!-- ==================== TextAppearance 属性 ==================== -->

    <!-- 卡片标题 (tool_card_item, media_tool_card_item 等) -->
    <attr name="npzCardTitleTextAppearance" format="reference" />

    <!-- 卡片描述文字 -->
    <attr name="npzCardBodyTextAppearance" format="reference" />

    <!-- 分区标题 / 统计区标题 (粗体) -->
    <attr name="npzSectionTitleTextAppearance" format="reference" />

    <!-- 信息标签 (辅助说明文字) -->
    <attr name="npzInfoLabelTextAppearance" format="reference" />

    <!-- 统计数值 (粗体数值显示) -->
    <attr name="npzStatValueTextAppearance" format="reference" />

    <!-- 列表项标题 -->
    <attr name="npzListItemTitleTextAppearance" format="reference" />

    <!-- 列表项副标题 -->
    <attr name="npzListItemSubtitleTextAppearance" format="reference" />

    <!-- Toolbar 标题 -->
    <attr name="npzToolbarTitleTextAppearance" format="reference" />

    <!-- 对话框标题 -->
    <attr name="npzDialogTitleTextAppearance" format="reference" />

    <!-- 对话框正文 -->
    <attr name="npzDialogBodyTextAppearance" format="reference" />

    <!-- ==================== Widget 样式属性 ==================== -->

    <!-- 轮廓线卡片 (边框型) -->
    <attr name="npzOutlinedCardStyle" format="reference" />

    <!-- 填充卡片 (背景色型) -->
    <attr name="npzFilledCardStyle" format="reference" />

    <!-- ==================== 语义色彩属性 ==================== -->

    <!-- 卡片标题颜色 -->
    <attr name="npzCardTitleColor" format="color" />

    <!-- 卡片描述颜色 -->
    <attr name="npzCardBodyColor" format="color" />

    <!-- 卡片图标色调 -->
    <attr name="npzCardIconTint" format="color" />

    <!-- 辅助箭头/指示器颜色 -->
    <attr name="npzCardArrowTint" format="color" />

    <!-- ==================== 尺寸属性 ==================== -->

    <!-- 卡片圆角半径 -->
    <attr name="npzCardCornerRadius" format="dimension" />

    <!-- 卡片图标容器大小 -->
    <attr name="npzCardIconContainerSize" format="dimension" />

    <!-- 卡片图标大小 -->
    <attr name="npzCardIconSize" format="dimension" />

    <!-- 屏幕边缘间距 -->
    <attr name="npzScreenEdgeMargin" format="dimension" />

</resources>
