<resources
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="PrivateResource">

    <style name="Preference.MaterialFiles.Material3.SimpleMenuPreference" parent="Preference.SimpleMenuPreference">
        <item name="android:popupMenuStyle">@style/Widget.MaterialFiles.Material3.Preference.SimpleMenuPreference.PopupMenu</item>
    </style>
    <style name="Widget.MaterialFiles.Material3.Preference.SimpleMenuPreference.PopupMenu" parent="Widget.Preference.SimpleMenuPreference.PopupMenu">
        <item name="android:popupBackground">@drawable/m3_popupmenu_background_overlay</item>
    </style>

    <style name="Preference.MaterialFiles.Material3.SwitchPreferenceCompat" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/switch_preference_compat_widget_material3</item>
    </style>

    <!--
      以下旧样式保留为别名，指向 NpzLib 中的统一定义。
      新代码应直接使用 ?attr/npzXxx 属性或 @style/TextAppearance.NpzLib.Xxx 样式。
    -->

    <!-- 向后兼容: ShapeAppearance 别名 -->
    <style name="ShapeAppearance.MaterialFiles.Material3.SmallComponent" parent="ShapeAppearance.NpzLib.SmallComponent" />
    <style name="ShapeAppearance.MaterialFiles.Material3.MediumComponent" parent="ShapeAppearance.NpzLib.MediumComponent" />
    <style name="ShapeAppearance.MaterialFiles.Material3.LargeComponent" parent="ShapeAppearance.NpzLib.LargeComponent" />

    <!-- 向后兼容: TextAppearance 别名 -->
    <style name="TextAppearance.MaterialFiles.Material3.ListItem" parent="TextAppearance.NpzLib.ListItemTitle" />
    <style name="TextAppearance.MaterialFiles.Material3.ListItemSmall" parent="TextAppearance.NpzLib.ListItemSubtitle" />
    <style name="TextAppearance.MaterialFiles.Material3.ListItem.Compact" parent="TextAppearance.NpzLib.ListItemTitle.Compact" />
    <style name="TextAppearance.MaterialFiles.Material3.ListItemSmall.Compact" parent="TextAppearance.NpzLib.ListItemSubtitle.Compact" />
    <style name="TextAppearance.MaterialFiles.Material3.AboutAppName" parent="TextAppearance.NpzLib.AboutAppName" />
    <style name="TextAppearance.MaterialFiles.Material3.AboutListItem" parent="TextAppearance.NpzLib.AboutListItem" />
    <style name="TextAppearance.MaterialFiles.Material3.ToolbarTitle" parent="TextAppearance.NpzLib.ToolbarTitle" />

    <!-- 向后兼容: Widget 别名 -->
    <style name="Widget.MaterialFiles.Material3.Toolbar" parent="Widget.NpzLib.Toolbar">
        <item name="contentInsetStartWithNavigation">@dimen/toolbar_content_inset_with_nav</item>
    </style>

    <style name="Widget.MaterialFiles.Material3.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="itemHorizontalPadding">@dimen/navigation_item_horizontal_padding_material3</item>
        <item name="itemSubtitleTextAppearance">?textAppearanceBodyMedium</item>
        <item name="itemSubtitleTextColor">@color/navigation_item_subtitle_text_color_material3</item>
        <item name="itemSubtitleTextSize">10sp</item>
        <item name="itemIconPadding">@dimen/navigation_item_icon_padding_material3</item>
        <item name="dividerVerticalPadding">@dimen/navigation_separator_vertical_padding</item>
    </style>

    <style name="Widget.MaterialFiles.Material3.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
