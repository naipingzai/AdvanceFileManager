  ~
  ~ 语义化样式定义
  ~ 提供统一的 TextAppearance 和 Widget 样式，确保全局一致性。
  -->

<resources>

    <!-- ==================== 语义化 TextAppearance ==================== -->

    <!--
      卡片标题: 用于卡片式列表项的主标题
      特征: 中等字号, 不加粗, 使用 plain regular 字体 (与列表项保持一致)
      适用: tool_card_item, media_tool_card_item, feature 列表等
    -->
    <style name="TextAppearance.NpzLib.CardTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <!--
      卡片描述: 用于卡片式列表项的副文字/描述
      特征: 小字号, colorOnSurfaceVariant 颜色, 使用 plain regular 字体
      适用: 各种卡片的描述文字
    -->
    <style name="TextAppearance.NpzLib.CardBody" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <!--
      分区标题: 用于页面内分区/统计区的标题
      特征: 小号粗体, 主色文字
      适用: 搜索结果统计区标题, 文件分析区标题等
    -->
    <style name="TextAppearance.NpzLib.SectionTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <!--
      信息标签: 辅助性说明文字
      特征: 中等字号, 次要颜色
      适用: 设备信息, 版本号, 状态提示
    -->
    <style name="TextAppearance.NpzLib.InfoLabel" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?colorOnSurfaceVariant</item>
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <!--
      统计数值: 突出显示的数值
      特征: 小号粗体
      适用: 文件大小数值, 数量统计, 进度数值
    -->
    <style name="TextAppearance.NpzLib.StatValue" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?colorOnSurface</item>
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <!--
      列表项标题: 标准列表项主文字
      特征: 中等字号, 非粗体, 使用 plain regular 字体
      适用: 文件列表, 设置项标题
    -->
    <style name="TextAppearance.NpzLib.ListItemTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <!--
      列表项副标题: 标准列表项副文字
      特征: 小号, 非粗体, 使用 plain regular 字体
    -->
    <style name="TextAppearance.NpzLib.ListItemSubtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <!--
      列表项标题 (紧凑版): 设置页/关于页专用
      特征: 14sp 小字号
    -->
    <style name="TextAppearance.NpzLib.ListItemTitle.Compact" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!--
      列表项副标题 (紧凑版): 设置页/关于页专用
      特征: 12sp 小字号
    -->
    <style name="TextAppearance.NpzLib.ListItemSubtitle.Compact" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <!--
      Toolbar 标题: 应用栏标题
      特征: 16sp, 继承 TitleLarge
    -->
    <style name="TextAppearance.NpzLib.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <!--
      对话框标题
      特征: 中等字号粗体
    -->
    <style name="TextAppearance.NpzLib.DialogTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <!--
      对话框正文
      特征: 标准正文字号
    -->
    <style name="TextAppearance.NpzLib.DialogBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <!--
      关于页 App 名称
      特征: 18sp
    -->
    <style name="TextAppearance.NpzLib.AboutAppName" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <!--
      关于页列表项
      特征: 14sp
    -->
    <style name="TextAppearance.NpzLib.AboutListItem" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <!-- ==================== Widget 样式 ==================== -->

    <!--
      轮廓线卡片: 1dp 边框, 无阴影
      适用: 标准工具卡片, 列表项卡片
    -->
    <style name="Widget.NpzLib.CardView.Outlined" parent="Widget.Material3.CardView.Elevated">
        <item name="android:stateListAnimator">@null</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <!--
      填充卡片: 背景色填充, 无边框
      适用: 媒体工具卡片, 特色功能卡片
    -->
    <style name="Widget.NpzLib.CardView.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="android:stateListAnimator">@null</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardBackgroundColor">?colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <!--
      ShapeAppearance 圆角系列
    -->
    <style name="ShapeAppearance.NpzLib.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.NpzLib.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.NpzLib.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <!--
      Toolbar 样式
    -->
    <style name="Widget.NpzLib.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.NpzLib.ToolbarTitle</item>
    </style>

    <!-- ==================== M3 Typography 全局覆盖 ==================== -->
    <!--
      覆盖 Material3 默认 TextAppearance, 将字体从 sans-serif-medium 统一为 sans-serif (regular)。
      这些样式通过 Theme 的 textAppearance* 属性引用, 确保所有使用 ?textAppearanceTitleSmall 等
      attr 的布局都能获得一致的字体风格。
    -->

    <style name="TextAppearance.NpzLib.M3.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

    <style name="TextAppearance.NpzLib.M3.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@string/npzlib_typeface_plain_regular</item>
        <item name="android:fontFamily">@string/npzlib_typeface_plain_regular</item>
    </style>

</resources>
