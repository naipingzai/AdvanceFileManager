<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="?appScreenEdgeMargin"
    android:layout_marginEnd="?appScreenEdgeMargin"
    android:layout_marginTop="@dimen/app_card_margin_vertical"
    android:layout_marginBottom="@dimen/app_card_margin_vertical"
    android:clickable="true"
    android:focusable="true"
    style="?appFilledCardStyle"
    android:foreground="?selectableItemBackground"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/app_card_padding_horizontal"
        android:paddingEnd="@dimen/app_card_padding_horizontal"
        android:paddingTop="@dimen/app_card_padding_vertical"
        android:paddingBottom="@dimen/app_card_padding_vertical">

        <!-- Icon with rounded tinted background -->
        <FrameLayout
            android:layout_width="@dimen/app_card_icon_container_size"
            android:layout_height="@dimen/app_card_icon_container_size">

            <View
                android:id="@+id/iconBackground"
                android:layout_width="@dimen/app_card_icon_container_size"
                android:layout_height="@dimen/app_card_icon_container_size"
                android:background="@drawable/icon_circle_background" />

            <ImageView
                android:id="@+id/featureIcon"
                android:layout_width="@dimen/app_card_icon_size"
                android:layout_height="@dimen/app_card_icon_size"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                app:tint="?colorOnPrimaryContainer" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/app_card_icon_text_spacing"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/featureTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?appCardTitleTextAppearance"
                android:textColor="?appCardTitleColor"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/featureDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?appCardBodyTextAppearance"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/app_card_arrow_size"
            android:layout_height="@dimen/app_card_arrow_size"
            android:src="@drawable/arrow_end_icon_white_24dp"
            app:tint="?appCardArrowTint"
            android:alpha="0.6"
            android:importantForAccessibility="no" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
