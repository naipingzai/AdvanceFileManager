<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <naipingzai.materialfile.ui.CoordinatorAppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorAppBarSurface"
        android:theme="?actionBarTheme"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/recyclerView">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            app:popupTheme="?actionBarPopupTheme" />
    </naipingzai.materialfile.ui.CoordinatorAppBarLayout>

    <naipingzai.materialfile.ui.CoordinatorScrollingFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- FFmpeg version info chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/screen_edge_margin"
                android:paddingEnd="@dimen/screen_edge_margin"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_xs">

                <View
                    android:id="@+id/ffmpegStatusDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/icon_circle_background"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/ffmpegVersionText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:textAppearance="?textAppearanceLabelSmall"
                    android:textColor="?colorOnSurfaceVariant"
                    android:contentDescription="@string/media_tool_ffmpeg_status_desc" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/operationProgressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/screen_edge_margin"
                android:visibility="gone"
                app:trackThickness="4dp" />

            <TextView
                android:id="@+id/operationStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/screen_edge_margin"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingBottom="@dimen/spacing_xs"
                android:textAppearance="?textAppearanceLabelSmall"
                android:textColor="?colorOnSurfaceVariant"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="0dp"
                android:paddingBottom="@dimen/screen_edge_margin"
                android:scrollbars="vertical" />
        </LinearLayout>
    </naipingzai.materialfile.ui.CoordinatorScrollingFrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
