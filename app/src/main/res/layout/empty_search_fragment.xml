<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <naipingzai.materialfile.ui.CoordinatorAppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorAppBarSurface"
        android:theme="?actionBarTheme"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/recyclerView">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            app:popupTheme="?actionBarPopupTheme" />
    </naipingzai.materialfile.ui.CoordinatorAppBarLayout>

    <naipingzai.materialfile.ui.CoordinatorScrollingFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Config panel -->
            <ScrollView
                android:id="@+id/configLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_edge_margin">

                    <!-- Search path -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardPreventCornerOverlap="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/empty_search_path"
                                android:textAppearance="?textAppearanceTitleSmall"
                                android:textStyle="bold" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/pathChipGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/addPathButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/tool_add_path"
                                app:icon="@drawable/add_icon_white_24dp"
                                style="@style/Widget.Material3.Button.OutlinedButton" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Search type & filter options -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardPreventCornerOverlap="false">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/empty_search_filter_options"
                                android:textAppearance="?textAppearanceTitleSmall"
                                android:textStyle="bold" />

                            <!-- Search type -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/empty_search_search_type"
                                android:textAppearance="?textAppearanceBodyMedium" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/searchTypeChipGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                app:singleSelection="false"
                                app:selectionRequired="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipEmptyFiles"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/empty_search_include_files"
                                    android:checked="true"
                                    style="@style/Widget.Material3.Chip.Filter" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipEmptyFolders"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/empty_search_include_folders"
                                    android:checked="true"
                                    style="@style/Widget.Material3.Chip.Filter" />
                            </com.google.android.material.chip.ChipGroup>

                            <!-- Hidden files/dirs toggles -->
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/includeHiddenDirsSwitch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:minHeight="48dp"
                                android:text="@string/empty_search_include_hidden_dirs" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/includeHiddenFilesSwitch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/empty_search_include_hidden_files" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/followSymlinksSwitch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/empty_search_follow_symlinks" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Search button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/searchButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/empty_search_action" />
                </LinearLayout>
            </ScrollView>

            <!-- Results layout -->
            <LinearLayout
                android:id="@+id/resultsLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/resultCountText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/screen_edge_margin"
                    android:paddingEnd="@dimen/screen_edge_margin"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textAppearance="?textAppearanceBodyMedium"
                    android:background="?colorSurfaceVariant" />

                <ProgressBar
                    android:id="@+id/searchProgressBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.LinearProgressIndicator"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:scrollbars="vertical" />
            </LinearLayout>
        </FrameLayout>
    </naipingzai.materialfile.ui.CoordinatorScrollingFrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
