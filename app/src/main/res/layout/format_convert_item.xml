<naipingzai.materialfile.ui.CheckableForegroundLinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Thumbnail / icon area -->
    <FrameLayout
        android:id="@+id/iconLayout"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="@dimen/screen_edge_margin"
        android:layout_marginEnd="12dp"
        android:clipToPadding="false"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/iconImage"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/thumbnailImage"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:duplicateParentState="true"
            android:scaleType="centerCrop" />

        <ImageView
            android:layout_width="@dimen/badge_size"
            android:layout_height="@dimen/badge_size"
            android:layout_gravity="end|bottom"
            android:duplicateParentState="true"
            android:src="@drawable/checkable_badge_18dp" />
    </FrameLayout>

    <!-- Content area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/screen_edge_margin"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <!-- File name -->
        <TextView
            android:id="@+id/nameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textAppearance="?textAppearanceListItem" />

        <!-- Description: type · size · media info -->
        <naipingzai.materialfile.ui.AutoGoneTextView
            android:id="@+id/descriptionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?textAppearanceListItemSecondary"
            android:textColor="?colorOnSurfaceVariant" />

        <!-- Format conversion indicator: [INPUT] → [OUTPUT] -->
        <LinearLayout
            android:id="@+id/formatRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inputFormatChip"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/format_chip_input_background"
                android:textAppearance="?textAppearanceLabelMedium"
                android:textColor="?colorOnTertiaryContainer"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/arrow_end_icon_white_24dp"
                android:tint="?colorOnSurfaceVariant"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/outputFormatChip"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/format_chip_output_background"
                android:textAppearance="?textAppearanceLabelMedium"
                android:textColor="?colorOnPrimaryContainer"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Path -->
        <naipingzai.materialfile.ui.AutoGoneTextView
            android:id="@+id/pathText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textAppearance="?textAppearanceLabelSmall"
            android:textColor="?colorOnSurfaceVariant" />

        <!-- Status -->
        <naipingzai.materialfile.ui.AutoGoneTextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?textAppearanceLabelSmall"
            android:textColor="?colorPrimary" />

        <!-- Per-item progress bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/itemProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:trackThickness="4dp"
            app:trackCornerRadius="2dp" />
    </LinearLayout>
</naipingzai.materialfile.ui.CheckableForegroundLinearLayout>
