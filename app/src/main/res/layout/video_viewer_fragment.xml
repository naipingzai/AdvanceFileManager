<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/media_background">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:show_buffering="when_playing"
        app:resize_mode="fit" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />

    <TextView
        android:id="@+id/speedIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/speed_indicator_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="?colorOnSurface"
        android:textAppearance="?textAppearanceTitleMedium"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="2.0x" />

    <!-- Top App Bar -->
    <FrameLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/video_viewer_gradient_top">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:theme="?actionBarTheme"
            app:popupTheme="?actionBarPopupTheme" />
    </FrameLayout>

    <!-- Bottom seek progress bar -->
    <LinearLayout
        android:id="@+id/seekBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/video_viewer_gradient_bottom"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:visibility="gone">

            <com.google.android.material.slider.Slider
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/video_viewer_seekbar"
            android:valueFrom="0"
            android:valueTo="1000"
            android:value="0"
            app:thumbColor="?colorOnSurface"
            app:thumbRadius="6dp"
            app:trackColorActive="?colorOnSurface"
            app:trackColorInactive="@color/video_slider_track_inactive"
            app:haloColor="@color/video_slider_halo"
            app:labelBehavior="gone"
            app:trackHeight="3dp" />

        <LinearLayout
            android:id="@+id/timeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/seekCurrentTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?colorOnSurface"
                android:textAppearance="?textAppearanceLabelSmall"
                android:fontFamily="monospace"
                tools:text="00:00" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/seekTotalTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?colorOnSurfaceVariant"
                android:textAppearance="?textAppearanceLabelSmall"
                android:fontFamily="monospace"
                tools:text="00:00" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
