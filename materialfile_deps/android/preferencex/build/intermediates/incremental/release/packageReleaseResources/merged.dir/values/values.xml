<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <attr format="color" name="pref_masterSwitchBackgroundOff"/>
    <attr format="color" name="pref_masterSwitchBackgroundOn"/>
    <attr format="reference" name="pref_masterSwitchStyle"/>
    <attr format="reference" name="pref_masterSwitchTextAppearance"/>
    <item name="pref_master_switch_view" type="id"/>
    <style name="PreferenceMasterSwitch" parent="">
        <item name="pref_masterSwitchTextAppearance">@style/PreferenceMasterSwitch.TextAppearance
        </item>
        <item name="pref_masterSwitchBackgroundOn">?colorAccent</item>
        <item name="pref_masterSwitchBackgroundOff">#80868b</item>
        <item name="switchStyle">@style/PreferenceMasterSwitch.Switch</item>
        <item name="android:theme">@style/ThemeOverlay.AppCompat.Dark</item>
        
    </style>
    <style name="PreferenceMasterSwitch.Switch" parent="@style/Widget.AppCompat.CompoundButton.Switch">
        <item name="trackTint">#33ffffff</item>
        <item name="thumbTint">@android:color/white</item>
    </style>
    <style name="PreferenceMasterSwitch.TextAppearance" parent="@style/TextAppearance.AppCompat.Body2">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@android:color/white</item>
    </style>
    <style name="Preference_TextAppearanceMaterialBody2">
        <item name="android:textSize">14sp</item>
        
        <item name="android:typeface">sans</item>
        <item name="android:fontFamily" ns1:ignore="NewApi">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>
    <declare-styleable name="AutoSummaryEditTextPreference">
        <attr format="string|reference" name="pref_summaryHasText"/>
        <attr format="string|reference" name="pref_summaryPasswordSubstitute"/>
        <attr format="integer|reference" name="pref_summaryPasswordSubstituteLength"/>
    </declare-styleable>
    <declare-styleable name="EditTextPreference">
        <attr format="boolean|reference" name="pref_disableMessagePaddingFix"/>
    </declare-styleable>
    <declare-styleable name="PreferenceCategory">
        <attr format="color|reference" name="pref_categoryColor"/>
    </declare-styleable>
</resources>