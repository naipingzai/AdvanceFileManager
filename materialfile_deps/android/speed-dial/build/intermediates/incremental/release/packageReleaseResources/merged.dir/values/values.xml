<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="sd_label_background_color">@color/cardview_light_background</color>
    <color name="sd_label_text_color">#757575</color>
    <color name="sd_overlay_color">#aaffffff</color>
    <dimen name="sd_close_elevation">5dp</dimen>
    <dimen name="sd_fab_mini_size">54dp</dimen>
    <dimen name="sd_fab_normal_size">72dp</dimen>
    <dimen name="sd_fab_side_margin">12dp</dimen>
    <dimen name="sd_label_max_width">160dp</dimen>
    <dimen name="sd_open_elevation">8dp</dimen>
    <dimen name="sd_overlay_elevation">@dimen/sd_close_elevation</dimen>
    <item name="sd_main_fab" type="id"/>
    <integer name="sd_close_animation_duration">200</integer>
    <integer name="sd_open_animation_duration">150</integer>
    <integer name="sd_rotate_animation_duration">200</integer>
    <string name="speeddial_scrolling_view_snackbar_behavior" ns1:ignore="UnusedResources">
        com.leinardi.android.speeddial.SpeedDialView$ScrollingViewSnackbarBehavior
    </string>
    <string name="speeddial_snackbar_behavior" ns1:ignore="UnusedResources">
        com.leinardi.android.speeddial.SpeedDialView$SnackbarBehavior
    </string>
    <style name="SpeedDial"/>
    <style name="SpeedDial.Base"/>
    <style name="SpeedDial.Base.FabLabelStyle">
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:maxWidth">@dimen/sd_label_max_width</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:textAppearance">?android:textAppearanceSmall</item>
        <item name="android:textColor">@color/sd_label_text_color</item>
    </style>
    <style name="SpeedDial.FabLabelStyle" parent="SpeedDial.Base.FabLabelStyle">
        <item name="android:textStyle">bold</item>
    </style>
    <declare-styleable name="FabWithLabelView">
        <attr name="android:src"/>
        <attr name="srcCompat"/>
        <attr format="string" name="fabLabel"/>
        <attr format="color" name="fabBackgroundColor"/>
        <attr format="color" name="fabLabelColor"/>
        <attr format="color" name="fabLabelBackgroundColor"/>
        <attr format="boolean" name="fabLabelClickable"/>
    </declare-styleable>
    <declare-styleable name="SpeedDialOverlayLayout">
        <attr format="boolean" name="clickable_overlay"/>
        <attr name="android:background"/>
    </declare-styleable>
    <declare-styleable name="SpeedDialView">
        <attr name="android:enabled"/>
        <attr format="enum" name="sdExpansionMode">
            <enum name="top" value="0"/>
            <enum name="bottom" value="1"/>
            <enum name="left" value="2"/>
            <enum name="right" value="3"/>
        </attr>
        <attr format="float" name="sdMainFabAnimationRotateAngle"/>
        <attr format="reference" name="sdMainFabClosedSrc"/>
        <attr format="color" name="sdMainFabClosedIconColor"/>
        <attr format="color" name="sdMainFabClosedBackgroundColor"/>
        <attr format="reference" name="sdMainFabOpenedSrc"/>
        <attr format="color" name="sdMainFabOpenedIconColor"/>
        <attr format="color" name="sdMainFabOpenedBackgroundColor"/>
        <attr format="reference" name="sdOverlayLayout"/>
        <attr format="boolean" name="sdUseReverseAnimationOnClose"/>
    </declare-styleable>
</resources>